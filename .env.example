# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key (server only; never use NEXT_PUBLIC_ prefix)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Sender domains every workspace may send from (comma separated, must be verified in Resend).
# Grant customer-owned domains per user in Administration instead of listing them here.
DEFAULT_SENDER_DOMAINS=

# Lead data order emails (optional). ORDER_FROM_EMAIL must be on a Resend-verified domain.
# Buyers get a confirmation; ORDER_NOTIFICATION_EMAIL gets a "new order" alert.
ORDER_FROM_EMAIL=
ORDER_NOTIFICATION_EMAIL=

# Contact form + AI support agent. Tickets and messages are emailed to CONTACT_TO_EMAIL.
# SUPPORT_FROM_EMAIL must be on a Resend-verified domain (falls back to ORDER_FROM_EMAIL).
CONTACT_TO_EMAIL=info@mymailmarket.com
SUPPORT_FROM_EMAIL=
# Server-only key for the support assistant (optional model override: SUPPORT_AGENT_MODEL)
ANTHROPIC_API_KEY=

# Free-trial test email is sent through Resend from this address (falls back to
# SUPPORT_FROM_EMAIL, then ORDER_FROM_EMAIL). Must be on a Resend-verified domain.
TRIAL_FROM_EMAIL=

# Legacy recurring mailbox checkout only (server only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal package checkout
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# Paystack package checkout
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Business lead discovery (server-only Hunter API key)
HUNTER_API_KEY=

# Truehost domain availability search (server-only)
TRUEHOST_API_URL=https://truehost.cloud/cloud/modules/addons/DomainsReseller/api/index.php
TRUEHOST_API_USERNAME=
TRUEHOST_API_KEY=

# Set to https://mymailmarket.com in production; keep localhost for local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional UI flag; account creation must also be enabled in Supabase Auth
NEXT_PUBLIC_ALLOW_SIGNUP=true

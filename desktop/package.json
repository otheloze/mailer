{
  "name": "mymailmarket-desktop",
  "productName": "MYMAILMARKET",
  "version": "1.0.0",
  "description": "MYMAILMARKET email marketing for Windows desktop.",
  "author": "MYMAILMARKET",
  "homepage": "https://mymailmarket.com",
  "private": true,
  "main": "main.js",
